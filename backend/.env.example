# Mollie API key — te vinden op https://my.mollie.com/dashboard/developers/api-keys
# Gebruik de test_... sleutel voor testen, live_... voor productie
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Poort waarop de backend draait (standaard 3001)
PORT=3001

# URL van de frontend (voor CORS)
FRONTEND_URL=http://localhost:5173

# Mollie webhook URL — vereist voor productiemodus
# Lokaal testen: gebruik ngrok → https://JOUW-NGROK-ID.ngrok.io/webhook
# Productie:     https://JOUW-DOMEIN.nl/webhook
# MOLLIE_WEBHOOK_URL=https://JOUW-NGROK-ID.ngrok.io/webhook
